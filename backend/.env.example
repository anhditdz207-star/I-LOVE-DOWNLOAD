# Origins allowed to call the API (comma separated). Use your GitHub Pages origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Thêm địa chỉ GitHub Pages nếu muốn dùng trang trên mạng với backend trên máy bạn: https://<tên-github>.github.io
TMP_TTL_SECONDS=900
RATE_LIMIT_PER_MIN=20
MAX_DURATION_SECONDS=3600
MAX_FILESIZE_MB=500
MAX_CONCURRENT_DOWNLOADS=1
# Set true only behind a trusted reverse proxy (Render, nginx) so the client IP is read from X-Forwarded-For
TRUST_PROXY=false
